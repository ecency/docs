---
import Default from "@astrojs/starlight/components/SocialIcons.astro";
---

<a class="ecency-open" href="https://ecency.com" target="_blank" rel="noopener">Open Ecency</a>
<Default />

<style>
  .ecency-open {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    /* Fixed blue so white text passes 4.5:1 in both themes */
    background: #1b68da;
    color: #fff;
  }
  .ecency-open:hover {
    background: var(--sl-color-accent-high);
    color: var(--sl-color-black);
  }
</style>
